# Какие скиллы профиля публикуются в этот репозиторий.
#
# Приоритет правил:
#   1. [private]   — никогда не публикуется.
#   2. [publish]   — публикуется, даже если категория не в списке по умолчанию.
#   3. [defaults]  — категории, все скиллы которых публикуются по умолчанию.
#   4. Всё остальное — локально: в GitHub не уходит и коллегам не приезжает.
#
# Штатные скиллы Hermes (bundled) здесь не упоминаются: они приезжают сами.

[defaults]
publish_categories: certification

# Явные исключения: общие инструменты, которые команда получает вместе с профилем.
[publish]
autonomous-ai-agents/hermes-agent
productivity/docx
security/cve-sbom-vex-mapping
software-development/codeql-cli
software-development/profile-contribution
software-development/sast-cpp-without-build

# Явно локальные: не публикуются, даже если попадут в публикуемую категорию.
[private]
security/attack-surface-analysis
